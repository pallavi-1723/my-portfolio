# Copy this file to .env and fill in what you have. Leave a value empty to hide that feature.
# These values end up in the public build, so only put public URLs here, never secrets.

# Public URL of your deployed Streamlit app (shows the Live Demo button on the AI Resume Analyser card)
VITE_RESUME_ANALYSER_URL=VITE_RESUME_ANALYSER_URL=https://ai-resume-analyzer-pkegb8er7xpkj78htjcthw.streamlit.app/

# Optional: a Formspree/Getform endpoint URL. If empty, the contact form opens the visitor's email app instead.
VITE_FORM_ENDPOINT=
